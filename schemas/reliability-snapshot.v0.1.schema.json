{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://tivor.net/schemas/reliability-snapshot.v0.1.schema.json","title":"Tivor ReliabilitySnapshot V0.1","type":"object","additionalProperties":false,"required":["schema_version","analysis_policy_version","jitter_formula_version","measurement_window_seconds","provider_id","reachability","reliability","stages","failure_localization","observed_abnormalities","limitations","provenance"],"properties":{"schema_version":{"const":"0.1.0"},"analysis_policy_version":{"const":"0.1.0"},"jitter_formula_version":{"const":"adjacent-mad-v0.1"},"measurement_window_seconds":{"type":"integer","minimum":1,"maximum":30},"provider_id":{"type":"string","minLength":1},"reachability":{"enum":["AVAILABLE","UNAVAILABLE","CHALLENGE","INCOMPLETE","UNSUPPORTED","UNKNOWN"]},"reliability":{"enum":["STABLE","DEGRADED","UNSTABLE","INSUFFICIENT_DATA"]},"stages":{"type":"object"},"failure_localization":{"enum":["DNS","TCP","TLS","HTTPS","LONG_CONNECTION","MULTI_STAGE","NONE_OBSERVED","UNKNOWN"]},"observed_abnormalities":{"type":"array","items":{"type":"string"}},"limitations":{"type":"array","items":{"type":"string"},"minItems":1},"provenance":{"const":"observed_and_deterministic_analysis"}}}
