{
  "registry_version": "0.1.0",
  "kind": "tivor.open_probe.measurements",
  "measurements": [
    { "measurement_id": "dns.resolve", "version": "0.1.0", "capability": "dns.resolve", "network_io": true, "permissions": ["outbound_dns"], "default_timeout_ms": 5000, "max_attempts": 2, "failure_isolation": "check", "evidence": ["resolver_outcome", "answer_family", "answer_count", "duration_ms"], "limitations": ["Does not by itself attribute the physical resolver path"] },
    { "measurement_id": "tcp.connect", "version": "0.1.0", "capability": "tcp.connect", "network_io": true, "permissions": ["outbound_network"], "default_timeout_ms": 7000, "max_attempts": 2, "failure_isolation": "check", "evidence": ["address_family", "connect_outcome", "duration_ms"], "limitations": ["A successful connection does not establish application health"] },
    { "measurement_id": "tls.handshake", "version": "0.1.0", "capability": "tls.handshake", "network_io": true, "permissions": ["outbound_network"], "default_timeout_ms": 10000, "max_attempts": 2, "failure_isolation": "check", "evidence": ["address_family", "tls_version", "certificate_outcome", "handshake_outcome", "duration_ms"], "limitations": ["Uses normal certificate validation and performs no authenticated operation"] },
    { "measurement_id": "https.request", "version": "0.1.0", "capability": "https.request", "network_io": true, "permissions": ["outbound_network"], "default_timeout_ms": 12000, "max_attempts": 2, "failure_isolation": "check", "evidence": ["address_family", "response_class", "challenge_signal", "duration_ms"], "limitations": ["Anonymous reachability does not establish account eligibility"] },
    { "measurement_id": "websocket.handshake", "version": "0.1.0", "capability": "websocket.handshake", "network_io": true, "permissions": ["outbound_network"], "default_timeout_ms": 12000, "max_attempts": 1, "failure_isolation": "check", "evidence": ["address_family", "upgrade_outcome", "duration_ms"], "limitations": ["Tests only the reviewed anonymous handshake path"] },
    { "measurement_id": "ip_family.observe", "version": "0.1.0", "capability": "ip_family.observe", "network_io": false, "permissions": ["read_interfaces"], "default_timeout_ms": 3000, "max_attempts": 1, "failure_isolation": "check", "evidence": ["ipv4_available", "ipv6_available"], "limitations": ["Local address presence does not prove external reachability"] },
    { "measurement_id": "interface.snapshot", "version": "0.1.0", "capability": "interface.snapshot", "network_io": false, "permissions": ["read_interfaces"], "default_timeout_ms": 3000, "max_attempts": 1, "failure_isolation": "check", "evidence": ["interface_category", "address_family", "state"], "limitations": ["Export removes raw interface names and addresses"] },
    { "measurement_id": "route.lookup", "version": "0.1.0", "capability": "route.lookup", "network_io": false, "permissions": ["read_routes"], "default_timeout_ms": 3000, "max_attempts": 1, "failure_isolation": "check", "evidence": ["destination_reference", "interface_category", "address_family", "route_outcome"], "limitations": ["Route observation is point-in-time and may not expose all policy routing"] },
    { "measurement_id": "egress.observe", "version": "0.1.0", "capability": "egress.observe", "network_io": true, "permissions": ["outbound_network"], "default_timeout_ms": 10000, "max_attempts": 2, "failure_isolation": "check", "evidence": ["address_family", "country", "egress_consistency"], "limitations": ["Exact egress identity is private-local by default"] },
    { "measurement_id": "asn.lookup", "version": "0.1.0", "capability": "asn.lookup", "network_io": true, "permissions": ["outbound_network"], "default_timeout_ms": 10000, "max_attempts": 1, "failure_isolation": "check", "evidence": ["asn_outcome", "network_name", "prefix_class"], "limitations": ["Third-party ASN data may be stale or disagree"] },
    { "measurement_id": "provider.path", "version": "0.1.0", "capability": "provider.path", "network_io": false, "permissions": [], "default_timeout_ms": 0, "max_attempts": 1, "failure_isolation": "provider", "evidence": ["provider_id", "local_path_state", "confidence", "supporting_evidence_ids"], "limitations": ["Composition only; provider-wide state remains separate"] }
  ]
}
